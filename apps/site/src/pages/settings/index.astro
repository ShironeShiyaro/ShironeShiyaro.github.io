---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  DEFAULT_PREFERENCES,
  PREFERENCE_RADIO_SCRIPT,
  type PreferenceName,
} from '@selfpage/site-shell/preferences';

interface SettingsOption {
  value: string;
  label: string;
  hint: string;
}

interface SettingsGroup {
  name: PreferenceName;
  id: string;
  title: string;
  description: string;
  options: SettingsOption[];
}

/**
 * Task 08 Settings page (R08-2): exactly the three frozen preferences plus
 * Reset. No account, language, notification, search or analytics control is
 * added here (U12).
 *
 * Every option is a real native radio inside a `<label>`, grouped by a
 * `<fieldset>`/`<legend>` with an English text label, so keyboard arrow keys,
 * screen-reader grouping and browser translation all work without custom
 * widget semantics (U08/U10).
 */
const groups: SettingsGroup[] = [
  {
    name: 'theme',
    id: 'settings-theme',
    title: 'Theme',
    description: 'System follows the light or dark appearance of this device.',
    options: [
      { value: 'system', label: 'System', hint: 'Follow this device' },
      { value: 'light', label: 'Light', hint: 'Always use the light theme' },
      { value: 'dark', label: 'Dark', hint: 'Always use the dark theme' },
    ],
  },
  {
    name: 'motion',
    id: 'settings-motion',
    title: 'Reduced Motion',
    description: 'System follows the motion setting of this device.',
    options: [
      { value: 'system', label: 'System', hint: 'Follow this device' },
      { value: 'reduce', label: 'Reduce', hint: 'Turn off spatial animation' },
      { value: 'full', label: 'Full', hint: 'Allow motion; flashing stays disabled' },
    ],
  },
  {
    name: 'textSize',
    id: 'settings-text-size',
    title: 'Text Size',
    description:
      "Changes this site's typography only. Your browser's own text size and page zoom still apply.",
    options: [
      { value: 'default', label: 'Default', hint: 'The default reading size' },
      { value: 'small', label: 'Small', hint: 'Slightly smaller type' },
      { value: 'large', label: 'Large', hint: 'Slightly larger type' },
    ],
  },
];
---

<BaseLayout
  title="Settings"
  description="Theme, reduced motion and text size settings for this site."
>
  <article class="settings" aria-labelledby="settings-title">
    <h1 id="settings-title" class="settings__title">Settings</h1>
    <p class="settings__intro">
      These settings are stored in this browser only. They apply to every page of this site.
    </p>

    {
      groups.map((group) => (
        <section class="settings__group" aria-labelledby={group.id}>
          <h2 id={group.id} class="settings__heading">
            {group.title}
          </h2>
          <p class="settings__hint" id={`${group.id}-hint`}>
            {group.description}
          </p>
          <fieldset class="settings__options" aria-describedby={`${group.id}-hint`}>
            <legend class="visually-hidden">{group.title}</legend>
            {group.options.map((option) => (
              <label class="settings__option">
                <input
                  class="settings__radio"
                  type="radio"
                  name={group.name}
                  value={option.value}
                  data-preference={group.name}
                  checked={option.value === DEFAULT_PREFERENCES[group.name]}
                />
                <span class="settings__option-text">
                  <span class="settings__option-label">{option.label}</span>
                  <span class="settings__option-detail">{option.hint}</span>
                </span>
              </label>
            ))}
          </fieldset>
        </section>
      ))
    }

    <section class="settings__group" aria-labelledby="settings-reset">
      <h2 id="settings-reset" class="settings__heading">Reset</h2>
      <p class="settings__hint" id="settings-reset-hint">
        Restore the System theme, System reduced motion and Default text size.
      </p>
      <p class="settings__actions">
        <button
          type="button"
          class="settings__button"
          data-settings-reset
          aria-describedby="settings-reset-hint"
        >
          Reset Settings
        </button>
      </p>
    </section>

    <p class="settings__status" role="status" data-settings-status>
      Settings are saved only in this browser.
    </p>

    <!-- Review P2-5: the static markup can only render the defaults; this tiny
         parser-blocking script runs after the radios exist and before first
         paint, syncing the checked radio to the values the head boot script
         already applied. Generated from the shared preference constants. The
         bundled module later owns reactive updates. -->
    <script is:inline set:html={PREFERENCE_RADIO_SCRIPT}></script>
  </article>
</BaseLayout>

<script>
  import '../../components/settings/settings';
</script>

<style>
  .settings {
    min-inline-size: 0;
  }

  .settings__title {
    margin-block: 0 var(--space-4);
    padding-block-end: var(--space-4);
    border-block-end: var(--size-control-border) solid var(--color-border);
    overflow-wrap: anywhere;
  }

  .settings__intro {
    max-inline-size: var(--measure-prose);
    color: var(--color-text-secondary);
  }

  .settings__group {
    min-inline-size: 0;
    margin-block-start: var(--space-10);
  }

  .settings__heading {
    margin-block: 0 var(--space-2);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-snug);
    overflow-wrap: anywhere;
  }

  .settings__hint {
    max-inline-size: var(--measure-prose);
    margin-block: 0 var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
  }

  /* The fieldset itself carries no border: the option rows are the controls.
     `min-inline-size: 0` keeps long translated labels from widening the page. */
  .settings__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .settings__option {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-inline-size: 0;
    min-block-size: max(2.75rem, var(--size-target-min));
    padding: var(--space-2) var(--space-3);
    border: var(--size-control-border) solid var(--color-control-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .settings__radio {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin: 0.15em 0 0;
    accent-color: var(--color-focus);
  }

  .settings__option-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .settings__option-label {
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
    overflow-wrap: anywhere;
  }

  .settings__option-detail {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-snug);
    overflow-wrap: anywhere;
  }

  /* Current choice and hover use the same background overlay as the navigation
     (rule: state is never colour-only: the native radio + weight also change). */
  .settings__option:has(.settings__radio:checked) {
    background-color: var(--color-state-surface);
    border-color: var(--color-text);
  }

  .settings__option:has(.settings__radio:focus-visible) {
    outline: var(--size-focus-ring) solid var(--color-focus);
    outline-offset: var(--size-focus-offset);
  }

  @media (hover: hover) {
    .settings__option:hover {
      background-color: var(--color-state-surface);
    }
  }

  .settings__actions {
    margin-block: 0;
  }

  .settings__button {
    min-block-size: max(2.75rem, var(--size-target-min));
    min-inline-size: max(2.75rem, var(--size-target-min));
    padding: var(--space-2) var(--space-4);
    color: var(--color-text);
    background-color: transparent;
    border: var(--size-control-border) solid var(--color-control-border);
    border-radius: var(--radius-sm);
    font: inherit;
    line-height: var(--line-height-snug);
    text-align: center;
    text-wrap: balance;
    overflow-wrap: anywhere;
    cursor: pointer;
    transition: background-color var(--motion-duration-fast) var(--motion-easing-standard);
  }

  @media (hover: hover) {
    .settings__button:hover {
      background-color: var(--color-state-surface);
    }
  }

  .settings__status {
    max-inline-size: var(--measure-prose);
    margin-block: var(--space-10) 0;
    padding-block-start: var(--space-4);
    border-block-start: var(--size-control-border) solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    overflow-wrap: anywhere;
  }

  /* Forced Colors: the native radio and system colours keep the choice,
     polarity and focus visible even though our surfaces are replaced. */
  @media (forced-colors: active) {
    .settings__option {
      border-color: CanvasText;
    }

    .settings__option:has(.settings__radio:checked) {
      outline: var(--size-focus-ring) solid Highlight;
      outline-offset: calc(-1 * var(--size-focus-ring));
    }

    .settings__option:has(.settings__radio:focus-visible) {
      outline-color: Highlight;
    }

    .settings__button:focus-visible {
      outline-color: Highlight;
    }
  }

  @media (max-width: 24em) {
    .settings__heading {
      font-size: var(--font-size-lg);
    }
  }
</style>
